    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# ==========================================\n",
    "# 1. AUTO-FIX ENVIRONMENT & DEPENDENCIES\n",
    "# ==========================================\n",
    "print(\"🛠️ Checking and fixing environment...\")\n",
    "\n",
    "# 1. Install timm if missing\n",
    "try:\n",
    "    import timm\n",
    "except ImportError:\n",
    "    print(\"📥 Installing timm...\")\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"timm\", \"-q\"])\n",
    "    import timm\n",
    "\n",
    "# 2. Download models_baselines.py if missing\n",
    "if not os.path.exists('models_baselines.py'):\n",
    "    print(\"📥 Downloading models_baselines.py from GitHub...\")\n",
    "    import urllib.request\n",
