   "source": [
    "import os\n",
    "import sys\n",
    "import gc\n",
    "import time\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from torch.utils.data import DataLoader, Dataset\n",
    "from datasets import load_dataset\n",
    "from sklearn.metrics import accuracy_score, f1_score, precision_score, recall_score\n",
    "from tabulate import tabulate\n",
    "import torchvision.transforms as T\n",
    "from PIL import Image\n",
    "\n",
    "# ==========================================\n",
    "# 1. SETUP & CONFIGURATION\n",
    "# ==========================================\n",
    "print(\"🔧 Initializing DINOv2 Master Pipeline...\")\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"✅ Device: {DEVICE}\")\n",
    "\n",
    "# DINOv2 specific ImageNet normalization\n",
    "DINO_TRANSFORM = T.Compose([\n",
    "    T.Resize(256, interpolation=T.InterpolationMode.BICUBIC),\n",
    "    T.CenterCrop(224),\n",
    "    T.ToTensor(),\n",
    "    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "FEATURE_DIR = \"/kaggle/working/dinov2_features\"\n",
    "os.makedirs(FEATURE_DIR, exist_ok=True)\n",
    "\n",
    "DATASETS = {\n",
    "    'brisc': 'srijan2715/brisc2025-paper-pipeline',\n",
    "    'sartaj': 'srijan2715/sartaj-final-split'\n",
    "}\n",
    "\n",
    "# ==========================================\n",
    "# 2. LOAD DINOv2 (Official & Robust)\n",
    "# ==========================================\n",
    "print(\"🦖 Loading DINOv2 Base (ViT-B/14)...\")\n",
    "# Using torch.hub for the exact official weights, bypassing transformers/timm issues\n",
    "try:\n",
    "    dinov2_model = torch.hub.load('facebookresearch/dinov2', 'dinov2_vitb14').to(DEVICE)\n",
    "    dinov2_model.eval()\n",
    "    print(\"✅ DINOv2 loaded successfully.\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Failed to load DINOv2: {e}\")\n",
    "    sys.exit(1)\n",
    "\n",
    "# ==========================================\n",
    "# 3. FAST FEATURE EXTRACTION (The Speed Hack)\n",
    "# ==========================================\n",
    "def extract_and_cache_features(dataset_name, hf_path):\n",
    "    print(f\"\\n📥 Extracting features for {dataset_name}...\")\n",
    "    splits = {'train': 'train', 'val': 'val', 'test': 'test'}\n",
    "    \n",
    "    for split_name, hf_split in splits.items():\n",
    "        cache_path = os.path.join(FEATURE_DIR, f\"{dataset_name}_{split_name}.pt\")\n",
    "        \n",
    "        # Skip if already extracted (Massive time saver!)\n",
    "        if os.path.exists(cache_path):\n",
    "            print(f\"   ⏭️  {split_name} features already cached. Skipping.\")\n",
    "            continue\n",
    "            \n",
    "        print(f\"   🔄 Processing {split_name} split...\")\n",
    "        raw_data = load_dataset(hf_path, split=hf_split)\n",
    "        \n",
    "        features = []\n",
    "        labels = []\n",
    "        \n",
    "        # num_workers=0 prevents Kaggle RAM crashes\n",
    "        with torch.no_grad():\n",
    "            for i in range(len(raw_data)):\n",
    "                # Convert HF pixel list to PIL Image\n",
    "                img_data = raw_data[i]['image']\n",
    "                if isinstance(img_data, list):\n",
    "                    # Handle raw pixel lists if necessary, otherwise assume PIL\n",
    "                    img = Image.fromarray(np.array(img_data, dtype=np.uint8).reshape(224, 224, 3)) \n",
    "                else:\n",
    "                    img = img_data\n",
    "                \n",
    "                # Apply DINOv2 specific transforms\n",
    "                x = DINO_TRANSFORM(img).unsqueeze(0).to(DEVICE)\n",
    "                y = raw_data[i]['label']\n",
    "                \n",
    "                # Extract features\n",
    "                out = dinov2_model(x)\n",
    "                # DINOv2 outputs a dict or tensor. We want the pooled [CLS] token.\n",
    "                # If it's a dict, use out['x_norm_clstoken'], else use out[:, 0]\n",
    "                feat = out['x_norm_clstoken'] if isinstance(out, dict) else out[:, 0]\n",
    "                \n",
    "                features.append(feat.cpu().squeeze(0))\n",
    "                labels.append(y)\n",
    "                \n",
    "                if (i + 1) % 500 == 0:\n",
    "                    print(f\"      Processed {i+1}/{len(raw_data)} images...\")\n",
    "                    gc.collect() # Prevent memory leaks during extraction\n",
    "        \n",
    "        # Save to disk\n",
    "        torch.save({\n",
    "            'features': torch.stack(features),\n",
    "            'labels': torch.tensor(labels)\n",
    "        }, cache_path)\n",
    "        print(f\"   💾 Cached {split_name} features to disk ({len(features)} samples).\")\n",
    "        \n",
    "    gc.collect()\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "# Run extraction for both datasets\n",
    "for ds_name, ds_path in DATASETS.items():\n",
    "    extract_and_cache_features(ds_name, ds_path)\n",
    "\n",
    "# ==========================================\n",
    "# 4. DEFINE CLASSIFICATION HEADS\n",
    "# ==========================================\n",
    "class LinearProbe(nn.Module):\n",
    "    def __init__(self, in_dim=768, num_classes=4):\n",
    "        super().__init__()\n",
    "        self.head = nn.Linear(in_dim, num_classes)\n",
    "    def forward(self, x):\n",
    "        return self.head(x)\n",
    "\n",
    "class MLPHead(nn.Module): # Mimics ConvNeXt/Stronger head\n",
    "    def __init__(self, in_dim=768, num_classes=4):\n",
    "        super().__init__()\n",
    "        self.head = nn.Sequential(\n",
    "            nn.Linear(in_dim, 512),\n",
    "            nn.GELU(),\n",
    "            nn.Dropout(0.2),\n",
    "            nn.Linear(512, 256),\n",
    "            nn.GELU(),\n",
    "            nn.Dropout(0.1),\n",
    "            nn.Linear(256, num_classes)\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        return self.head(x)\n",
    "\n",
    "HEADS = {\n",
    "    'Linear_Probe': LinearProbe,\n",
    "    'MLP_Head': MLPHead\n",
    "}\n",
    "\n",
    "# ==========================================\n",
    "# 5. TRAIN & EVALUATE HEADS (Blazing Fast)\n",
    "# ==========================================\n",
    "def train_and_evaluate(head_name, head_class, dataset_name):\n",
    "    print(f\"\\n🚀 Training {head_name} on {dataset_name}...\")\n",
    "    \n",
    "    # Load cached features\n",
    "    train_data = torch.load(os.path.join(FEATURE_DIR, f\"{dataset_name}_train.pt\"))\n",
    "    val_data = torch.load(os.path.join(FEATURE_DIR, f\"{dataset_name}_val.pt\"))\n",
    "    test_data = torch.load(os.path.join(FEATURE_DIR, f\"{dataset_name}_test.pt\"))\n",
    "    \n",
    "    X_train, y_train = train_data['features'].to(DEVICE), train_data['labels'].to(DEVICE)\n",
    "    X_val, y_val = val_data['features'].to(DEVICE), val_data['labels'].to(DEVICE)\n",
    "    X_test, y_test = test_data['features'].to(DEVICE), test_data['labels'].to(DEVICE)\n",
    "    \n",
    "    # Create simple tensor datasets\n",
    "    class TensorDS(Dataset):\n",
    "        def __init__(self, x, y): self.x, self.y = x, y\n",
    "        def __len__(self): return len(self.x)\n",
    "        def __getitem__(self, i): return self.x[i], self.y[i]\n",
    "        \n",
    "    train_loader = DataLoader(TensorDS(X_train, y_train), batch_size=64, shuffle=True)\n",
    "    val_loader = DataLoader(TensorDS(X_val, y_val), batch_size=64, shuffle=False)\n",
    "    test_loader = DataLoader(TensorDS(X_test, y_test), batch_size=64, shuffle=False)\n",
    "    \n",
    "    model = head_class(in_dim=768, num_classes=4).to(DEVICE)\n",
    "    optimizer = optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-4)\n",
    "    criterion = nn.CrossEntropyLoss()\n",
    "    \n",
    "    # Fast Training Loop (5 Epochs is usually enough for frozen features)\n",
    "    best_val_acc = 0.0\n",
    "    for epoch in range(10):\n",
    "        model.train()\n",
    "        for bx, by in train_loader:\n",
    "            optimizer.zero_grad()\n",
    "            loss = criterion(model(bx), by)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "            \n",
    "        # Validation\n",
    "        model.eval()\n",
    "        val_preds, val_labels = [], []\n",
    "        with torch.no_grad():\n",
    "            for bx, by in val_loader:\n",
    "                _, preds = torch.max(model(bx), 1)\n",
    "                val_preds.extend(preds.cpu().numpy())\n",
    "                val_labels.extend(by.cpu().numpy())\n",
    "        \n",
    "        val_acc = accuracy_score(val_labels, val_preds)\n",
    "        if val_acc > best_val_acc:\n",
    "            best_val_acc = val_acc\n",
    "            \n",
    "    print(f\"   ✅ Best Val Acc: {best_val_acc:.4f}\")\n",
    "    \n",
    "    # Final Test Evaluation\n",
    "    model.eval()\n",
    "    test_preds, test_labels = [], []\n",
    "    with torch.no_grad():\n",
    "        for bx, by in test_loader:\n",
    "            _, preds = torch.max(model(bx), 1)\n",
    "            test_preds.extend(preds.cpu().numpy())\n",
    "            test_labels.extend(by.cpu().numpy())\n",
    "            \n",
    "    acc = accuracy_score(test_labels, test_preds)\n",
    "    prec = precision_score(test_labels, test_preds, average='weighted', zero_division=0)\n",
    "    rec = recall_score(test_labels, test_preds, average='weighted', zero_division=0)\n",
    "    f1 = f1_score(test_labels, test_preds, average='weighted', zero_division=0)\n",
    "    \n",
    "    return {'acc': acc, 'prec': prec, 'rec': rec, 'f1': f1}\n",
    "\n",
    "# ==========================================\n",
    "# 6. MASTER EXECUTION & TABLE GENERATION\n",
    "# ==========================================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"🏆 STARTING DINOv2 HEAD TRAINING & EVALUATION\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "results = []\n",
    "\n",
    "for ds_name in DATASETS.keys():\n",
    "    for head_name, head_class in HEADS.items():\n",
    "        metrics = train_and_evaluate(head_name, head_class, ds_name)\n",
    "        results.append({\n",
    "            'Model': f\"DINOv2 ({head_name})\",\n",
    "            'Dataset': ds_name.capitalize(),\n",
    "            'Accuracy': f\"{metrics['acc']:.4f}\",\n",
    "            'Precision': f\"{metrics['prec']:.4f}\",\n",
    "            'Recall': f\"{metrics['rec']:.4f}\",\n",
    "            'F1-Score': f\"{metrics['f1']:.4f}\"\n",
    "        })\n",
    "\n",
    "# Print Final Table\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"📊 DINOv2 FINAL RESULTS TABLE\")\n",
    "print(\"=\"*70)\n",
    "df = pd.DataFrame(results)\n",
    "print(tabulate(df, headers='keys', tablefmt='github', showindex=False))\n",
    "\n",
    "print(\"\\n✅ DINOv2 PIPELINE COMPLETE!\")"
   ]
  },
