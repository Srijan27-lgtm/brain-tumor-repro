    "# ==========================================\n",
    "print(\"🦖 Loading DINOv2 ViT-B/14...\")\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "dinov2 = torch.hub.load('facebookresearch/dinov2', 'dinov2_vitb14').to(DEVICE)\n",
    "dinov2.eval()\n",
    "\n",
    "# DINOv2 specific transforms\n",
    "transform = T.Compose([\n",
    "    T.Resize(256, interpolation=T.InterpolationMode.BICUBIC),\n",
    "    T.CenterCrop(224),\n",
    "    T.ToTensor(),\n",
    "    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "# Load CNN (ScratchCNN -> Timm ResNet50 -> Torchvision ResNet50)\n",
    "print(\"🧠 Loading CNN for visualization...\")\n",
    "cnn_model = None\n",
    "\n",
    "try:\n",
    "    from models_baselines import ScratchCNN\n",
    "    cnn_model = ScratchCNN(num_classes=4).to(DEVICE)\n",
    "    print(\"✅ Loaded ScratchCNN.\")\n",
    "except Exception as e:\n",
    "    print(f\"⚠️ ScratchCNN failed ({e}). Trying Timm ResNet50...\")\n",
    "    try:\n",
    "        cnn_model = timm.create_model('resnet50', pretrained=True, num_classes=4).to(DEVICE)\n",
    "        print(\"✅ Loaded Timm ResNet50.\")\n",
    "    except Exception as e2:\n",
    "        print(f\"⚠️ Timm failed ({e2}). Using Torchvision ResNet50 as ultimate fallback...\")\n",
    "        import torchvision.models as models\n",
    "        cnn_model = models.resnet50(pretrained=True)\n",
    "        cnn_model.fc = nn.Linear(2048, 4) # Match 4 classes\n",
    "        cnn_model = cnn_model.to(DEVICE)\n",
    "        print(\"✅ Loaded Torchvision ResNet50.\")\n",
    "\n",
    "cnn_model.eval()\n",
    "\n",
    "# ==========================================\n",
    "# 3. HELPER FUNCTIONS\n",
    "# ==========================================\n",
    "def get_first_layer_filters(model):\n",
    "    \"\"\"Extracts weights from the first Conv2d layer.\"\"\"\n",
    "    for module in model.modules():\n",
    "        if isinstance(module, nn.Conv2d):\n",
    "            return module.weight.data.cpu()\n",
    "    return None\n",
    "\n",
    "def generate_grad_cam(model, img_tensor, target_class):\n",
    "    \"\"\"Minimal PyTorch-native Grad-CAM implementation.\"\"\"\n",
    "    activations = None\n",
    "    gradients = None\n",
    "    \n",
    "    # Find the last Conv2d layer\n",
    "    target_layer = None\n",
    "    for module in model.modules():\n",
    "        if isinstance(module, nn.Conv2d):\n",
    "            target_layer = module\n",
    "            \n",
    "    def forward_hook(module, input, output):\n",
    "        nonlocal activations\n",
    "        activations = output\n",
    "        \n",
    "    def backward_hook(module, grad_in, grad_out):\n",
    "        nonlocal gradients\n",
    "        gradients = grad_out[0]\n",
    "        \n",
    "    hook1 = target_layer.register_forward_hook(forward_hook)\n",
    "    hook2 = target_layer.register_full_backward_hook(backward_hook)\n",
    "    \n",
    "    model.zero_grad()\n",
    "    output = model(img_tensor)\n",
    "    score = output[:, target_class].sum()\n",
    "    score.backward()\n",
    "    \n",
    "    weights = gradients.mean(dim=[2, 3], keepdim=True)\n",
    "    cam = (weights * activations).sum(dim=1, keepdim=True)\n",
    "    cam = F.relu(cam)\n",
    "    cam = F.interpolate(cam, size=(224, 224), mode='bilinear', align_corners=False)\n",
    "    \n",
    "    # FIX: Added .detach() to break the computation graph before converting to numpy\n",
    "    cam = cam.squeeze().detach().cpu().numpy() \n",
    "    cam = (cam - cam.min()) / (cam.max() - cam.min() + 1e-8)\n",
    "    \n",
    "    hook1.remove()\n",
    "    hook2.remove()\n",
    "    return cam\n",
    "\n",
    "def generate_dinov2_attention(model, img_tensor):\n",
    "    \"\"\"Generates a similarity map between CLS token and Patch tokens.\"\"\"\n",
    "    with torch.no_grad():\n",
    "        features = model.forward_features(img_tensor)\n",
    "        cls_token = features['x_norm_clstoken']\n",
    "        patch_tokens = features['x_norm_patchtokens']\n",
    "        \n",
    "    cls_token = F.normalize(cls_token, p=2, dim=1)\n",
    "    patch_tokens = F.normalize(patch_tokens, p=2, dim=2)\n",
    "    \n",
    "    similarity = torch.bmm(patch_tokens, cls_token.unsqueeze(2)).squeeze() \n",
    "    sim_map = similarity.reshape(1, 1, 16, 16)\n",
    "    sim_map = F.interpolate(sim_map, size=(224, 224), mode='bilinear', align_corners=False)\n",
    "    \n",
    "    # FIX: Added .detach() here too just to be absolutely safe\n",
    "    sim_map = sim_map.squeeze().detach().cpu().numpy()\n",
    "    sim_map = (sim_map - sim_map.min()) / (sim_map.max() - sim_map.min() + 1e-8)\n",
    "    return sim_map\n",
    "\n",
    "# ==========================================\n",
    "# 4. LOAD SAMPLE IMAGE\n",
    "# ==========================================\n",
    "print(\"📥 Loading sample image...\")\n",
    "dataset = load_dataset('srijan2715/brisc2025-paper-pipeline', split='test')\n",
    "sample = dataset[10] \n",
    "img_data = sample['image']\n",
    "true_label = sample['label']\n",
    "\n",
    "if isinstance(img_data, list):\n",
    "    img_array = np.array(img_data, dtype=np.uint8).reshape(224, 224, 3)\n",
    "    img_pil = Image.fromarray(img_array)\n",
    "else:\n",
    "    img_pil = img_data\n",
    "\n",
    "img_tensor = transform(img_pil).unsqueeze(0).to(DEVICE)\n",
    "\n",
    "# ==========================================\n",
    "# 5. GENERATE & PLOT VISUALIZATIONS\n",
    "# ==========================================\n",
    "print(\"🎨 Generating visualizations...\")\n",
    "\n",
    "filters = get_first_layer_filters(cnn_model)\n",
    "target_class = 0 \n",
    "cnn_cam = generate_grad_cam(cnn_model, img_tensor, target_class)\n",
    "dinov2_cam = generate_dinov2_attention(dinov2, img_tensor)\n",
    "\n",
    "fig = plt.figure(figsize=(18, 12))\n",
    "\n",
    "# Plot 1: Original Image\n",
    "ax1 = plt.subplot(2, 3, 1)\n",
    "ax1.imshow(img_pil)\n",
    "ax1.set_title('Original Image', fontsize=14, fontweight='bold')\n",
    "ax1.axis('off')\n",
    "\n",
    "# Plot 2: CNN Grad-CAM Overlay\n",
    "ax2 = plt.subplot(2, 3, 2)\n",
    "ax2.imshow(img_pil)\n",
    "ax2.imshow(cnn_cam, cmap='jet', alpha=0.5)\n",
    "ax2.set_title('CNN Grad-CAM (Local Focus)', fontsize=14, fontweight='bold')\n",
    "ax2.axis('off')\n",
    "\n",
    "# Plot 3: DINOv2 Attention Overlay\n",
    "ax3 = plt.subplot(2, 3, 3)\n",
    "ax3.imshow(img_pil)\n",
    "ax3.imshow(dinov2_cam, cmap='jet', alpha=0.5)\n",
    "ax3.set_title('DINOv2 Attention (Global Focus)', fontsize=14, fontweight='bold')\n",
    "ax3.axis('off')\n",
    "\n",
    "# Plot 4: CNN First Layer Filters (3x3 Grid)\n",
    "ax4 = plt.subplot(2, 3, 4)\n",
    "ax4.set_title('CNN First-Layer Filters (3x3 Grid)', fontsize=14, fontweight='bold')\n",
