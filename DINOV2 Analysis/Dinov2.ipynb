    "print(f\"🗺️ Label Mapping: {label_to_int}\")\n",
    "\n",
    "cnn_preds, dinov2_preds, true_labels = [], [], []\n",
    "cnn_confs, dinov2_confs = [], []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for i in range(len(dataset)):\n",
    "        sample = dataset[i]\n",
    "        img_data = sample['image']\n",
    "        true_label_str = sample['label']\n",
    "        \n",
    "        # FIX: Convert string label to integer\n",
    "        true_label = label_to_int[true_label_str]\n",
    "        \n",
    "        if isinstance(img_data, list):\n",
    "            img_array = np.array(img_data, dtype=np.uint8).reshape(224, 224, 3)\n",
    "            img_pil = Image.fromarray(img_array)\n",
    "        else:\n",
    "            img_pil = img_data\n",
    "            \n",
    "        # CNN Inference\n",
    "        x_cnn = cnn_transform(img_pil).unsqueeze(0).to(DEVICE)\n",
    "        out_cnn = cnn_model(x_cnn)\n",
    "        conf_cnn, pred_cnn = torch.max(F.softmax(out_cnn, dim=1), 1)\n",
    "        \n",
    "        # DINOv2 Inference\n",
    "        x_dino = test_data['features'][i].unsqueeze(0).to(DEVICE)\n",
    "        out_dino = dinov2_head(x_dino)\n",
    "        conf_dino, pred_dino = torch.max(F.softmax(out_dino, dim=1), 1)\n",
    "        \n",
    "        cnn_preds.append(pred_cnn.item())\n",
    "        dinov2_preds.append(pred_dino.item())\n",
    "        true_labels.append(true_label) # Now appending integer\n",
    "        cnn_confs.append(conf_cnn.item())\n",
    "        dinov2_confs.append(conf_dino.item())\n",
    "\n",
    "cnn_preds = np.array(cnn_preds)\n",
    "dinov2_preds = np.array(dinov2_preds)\n",
    "true_labels = np.array(true_labels)\n",
    "\n",
    "# ==========================================\n",
    "# 4. FIND DISAGREEMENTS\n",
    "# ==========================================\n",
    "cnn_correct = (cnn_preds == true_labels)\n",
    "dino_correct = (dinov2_preds == true_labels)\n",
    "\n",
    "idx_cnn_right_dino_wrong = np.where(cnn_correct & ~dino_correct)[0]\n",
    "idx_dino_right_cnn_wrong = np.where(dino_correct & ~cnn_correct)[0]\n",
    "\n",
    "print(f\"\\n📈 Total Test Samples: {len(dataset)}\")\n",
    "print(f\"✅ CNN Accuracy: {accuracy_score(true_labels, cnn_preds):.4f}\")\n",
    "print(f\"✅ DINOv2 Accuracy: {accuracy_score(true_labels, dinov2_preds):.4f}\")\n",
    "print(f\"🔀 CNN Right / DINOv2 Wrong: {len(idx_cnn_right_dino_wrong)} images\")\n",
    "print(f\"🔀 DINOv2 Right / CNN Wrong: {len(idx_dino_right_cnn_wrong)} images\")\n",
    "\n",
    "# ==========================================\n",
