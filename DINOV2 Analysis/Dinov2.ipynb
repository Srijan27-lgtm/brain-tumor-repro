    "criterion = nn.CrossEntropyLoss()\n",
    "\n",
    "X_train, y_train = train_data['features'], train_data['labels']\n",
    "train_loader = torch.utils.data.DataLoader(torch.utils.data.TensorDataset(X_train, y_train), batch_size=64, shuffle=True)\n",
    "\n",
    "dinov2_head.train()\n",
    "for epoch in range(5):\n",
    "    for bx, by in train_loader:\n",
    "        optimizer.zero_grad()\n",
    "        loss = criterion(dinov2_head(bx), by)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "dinov2_head.eval()\n",
    "print(\"✅ DINOv2 Linear Probe trained and ready.\")\n",
    "\n",
    "# ==========================================\n",
    "# 3. GET PREDICTIONS ON TEST SET (FIXED LABEL MAPPING)\n",
    "# ==========================================\n",
    "print(\"📊 Running inference on BRISC test set...\")\n",
    "dataset = load_dataset('srijan2715/brisc2025-paper-pipeline', split='test')\n",
