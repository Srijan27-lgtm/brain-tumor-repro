    "import os\n",
    "import torch\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.decomposition import PCA\n",
    "from datasets import load_dataset\n",
    "from PIL import Image\n",
    "import torchvision.transforms as T\n",
    "import warnings\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# ==========================================\n",
    "# 1. SETUP & MODEL LOADING\n",
    "# ==========================================\n",
    "print(\"🦖 Loading DINOv2 ViT-B/14...\")\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "model = torch.hub.load('facebookresearch/dinov2', 'dinov2_vitb14').to(DEVICE)\n",
    "model.eval()\n",
    "print(\"✅ DINOv2 loaded successfully.\")\n",
    "\n",
    "# DINOv2 specific transforms (224x224)\n",
    "transform = T.Compose([\n",
    "    T.Resize(256, interpolation=T.InterpolationMode.BICUBIC),\n",
    "    T.CenterCrop(224),\n",
    "    T.ToTensor(),\n",
    "    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "# ==========================================\n",
    "# 2. LOAD 5 SAMPLE IMAGES\n",
    "# ==========================================\n",
    "print(\"📥 Loading 5 sample images from BRISC test set...\")\n",
    "dataset = load_dataset('srijan2715/brisc2025-paper-pipeline', split='test')\n",
    "\n",
    "# Pick 5 random indices\n",
    "np.random.seed(42)\n",
    "sample_indices = np.random.choice(len(dataset), 5, replace=False)\n",
    "\n",
    "fig, axes = plt.subplots(5, 2, figsize=(10, 20))\n",
    "fig.suptitle('DINOv2 Patch Token PCA Visualization (ViT-B/14)', fontsize=16, fontweight='bold')\n",
    "\n",
    "for idx, row_idx in enumerate(sample_indices):\n",
    "    sample = dataset[row_idx]\n",
    "    img_data = sample['image']\n",
    "    true_label = sample['label']\n",
    "    \n",
    "    # FIX: Convert list to PIL Image if needed\n",
    "    if isinstance(img_data, list):\n",
    "        img_array = np.array(img_data, dtype=np.uint8).reshape(224, 224, 3)\n",
    "        img_pil = Image.fromarray(img_array)\n",
    "    else:\n",
    "        img_pil = img_data\n",
    "    \n",
    "    # 1. Prepare image for DINOv2\n",
    "    x = transform(img_pil).unsqueeze(0).to(DEVICE)\n",
    "    \n",
    "    # 2. Extract features using forward_features\n",
    "    with torch.no_grad():\n",
    "        features = model.forward_features(x)\n",
    "    \n",
    "    # FIX: DINOv2 returns a dictionary. Extract patch tokens using the correct key.\n",
    "    # 'x_norm_patchtokens' has shape [B, num_patches, dim] -> [1, 256, 768]\n",
    "    patch_tokens = features['x_norm_patchtokens'][0].cpu().numpy() # Shape: [256, 768]\n",
    "    \n",
    "    # 3. Apply PCA to reduce 768D -> 3D (RGB)\n",
    "    pca = PCA(n_components=3)\n",
