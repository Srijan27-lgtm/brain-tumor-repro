   "source": [
    "\n",
    "# ============================================================\n",
    "# DINOv2 FEATURE EXTRACTION: BRISC + SARTAJ\n",
    "# Model: DINOv2 ViT-B/14 (Pretrained, Frozen)\n",
    "# Task: 4-Class Brain MRI Classification\n",
    "# Feature: Normalized CLS Token (768 Dimensions)\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import gc\n",
    "import json\n",
    "from io import BytesIO\n",
    "\n",
    "import torch\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from PIL import Image\n",
    "from tqdm.auto import tqdm\n",
    "from datasets import load_dataset\n",
    "\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import torchvision.transforms as T\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. CONFIGURATION\n",
    "# ============================================================\n",
    "\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "BATCH_SIZE = 32\n",
    "NUM_WORKERS = 0\n",
    "IMAGE_SIZE = 224\n",
    "FEATURE_DIM = 768\n",
    "\n",
    "FEATURE_DIR = \"/kaggle/working/dino_features\"\n",
    "os.makedirs(FEATURE_DIR, exist_ok=True)\n",
    "\n",
    "DATASETS = {\n",
    "    \"brisc\": \"srijan2715/brisc2025-paper-pipeline\",\n",
    "    \"sartaj\": \"srijan2715/sartaj-final-split\"\n",
    "}\n",
    "\n",
    "SPLITS = [\"train\", \"val\", \"test\"]\n",
    "\n",
    "IMAGE_COLUMN = \"image\"\n",
    "LABEL_COLUMN = \"label\"\n",
    "\n",
    "CLASS_TO_ID = {\n",
    "    \"glioma\": 0,\n",
    "    \"meningioma\": 1,\n",
    "    \"no_tumor\": 2,\n",
    "    \"pituitary\": 3\n",
    "}\n",
    "\n",
    "ID_TO_CLASS = {\n",
    "    v: k for k, v in CLASS_TO_ID.items()\n",
    "}\n",
    "\n",
    "# Verify this mapping against original SARTAJ folders.\n",
    "SARTAJ_ID_TO_CLASS = {\n",
    "    0: \"glioma\",\n",
    "    1: \"meningioma\",\n",
    "    2: \"no_tumor\",\n",
    "    3: \"pituitary\"\n",
    "}\n",
    "\n",
    "EXPECTED_SARTAJ_TOTALS = {\n",
    "    0: 926,\n",
    "    1: 937,\n",
    "    2: 500,\n",
    "    3: 901\n",
    "}\n",
    "\n",
    "CACHE_VERSION = 5\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"DINOv2 FEATURE EXTRACTION\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\"Device:\", DEVICE)\n",
    "print(\"CUDA available:\", torch.cuda.is_available())\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    print(\"GPU:\", torch.cuda.get_device_name(0))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LABEL NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "def normalize_label(label, dataset_name):\n",
    "\n",
    "    if dataset_name == \"brisc\":\n",
    "\n",
    "        label = str(label).lower().strip()\n",
    "\n",
    "        label = label.replace(\" \", \"_\").replace(\"-\", \"_\")\n",
    "\n",
    "        aliases = {\n",
    "            \"notumor\": \"no_tumor\",\n",
    "            \"notumour\": \"no_tumor\",\n",
    "            \"no_tumour\": \"no_tumor\"\n",
    "        }\n",
    "\n",
    "        label = aliases.get(label, label)\n",
    "\n",
    "        if label not in CLASS_TO_ID:\n",
    "            raise ValueError(\n",
    "                f\"Unknown BRISC label: {label}\"\n",
    "            )\n",
    "\n",
    "        return CLASS_TO_ID[label]\n",
    "\n",
    "    elif dataset_name == \"sartaj\":\n",
    "\n",
    "        label = int(label)\n",
    "\n",
    "        if label not in SARTAJ_ID_TO_CLASS:\n",
    "            raise ValueError(\n",
    "                f\"Unknown SARTAJ label: {label}\"\n",
    "            )\n",
    "\n",
    "        class_name = SARTAJ_ID_TO_CLASS[label]\n",
    "\n",
    "        return CLASS_TO_ID[class_name]\n",
    "\n",
    "    raise ValueError(\n",
    "        f\"Unknown dataset: {dataset_name}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. IMAGE TRANSFORMATION\n",
    "# ============================================================\n",
    "\n",
    "DINO_TRANSFORM = T.Compose([\n",
    "\n",
    "    T.Resize((IMAGE_SIZE, IMAGE_SIZE)),\n",
    "\n",
    "    T.ToTensor(),\n",
    "\n",
    "    T.Normalize(\n",
    "        mean=(0.485, 0.456, 0.406),\n",
    "        std=(0.229, 0.224, 0.225)\n",
    "    )\n",
    "])\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD PRETRAINED DINOV2\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\nLoading DINOv2 ViT-B/14...\")\n",
    "\n",
    "dino_model = torch.hub.load(\n",
    "    \"facebookresearch/dinov2\",\n",
    "    \"dinov2_vitb14\",\n",
    "    pretrained=True\n",
    ")\n",
    "\n",
    "dino_model = dino_model.to(DEVICE)\n",
    "\n",
    "dino_model.eval()\n",
    "\n",
    "# Freeze model parameters.\n",
    "for parameter in dino_model.parameters():\n",
    "    parameter.requires_grad = False\n",
    "\n",
    "print(\"DINOv2 loaded successfully.\")\n",
    "\n",
    "print(\"Model: dinov2_vitb14\")\n",
    "print(\"Feature dimension:\", FEATURE_DIM)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. ROBUST IMAGE CONVERSION\n",
    "# ============================================================\n",
    "\n",
    "def convert_to_pil(image):\n",
    "\n",
    "    # PIL image\n",
    "    if isinstance(image, Image.Image):\n",
    "\n",
    "        return image.convert(\"RGB\")\n",
    "\n",
    "    # Dictionary image\n",
    "    if isinstance(image, dict):\n",
    "\n",
    "        if image.get(\"bytes\") is not None:\n",
    "\n",
    "            return Image.open(\n",
    "                BytesIO(image[\"bytes\"])\n",
    "            ).convert(\"RGB\")\n",
    "\n",
    "        if image.get(\"path\") is not None:\n",
    "\n",
    "            return Image.open(\n",
    "                image[\"path\"]\n",
    "            ).convert(\"RGB\")\n",
    "\n",
    "        if image.get(\"array\") is not None:\n",
    "\n",
    "            return convert_to_pil(\n",
    "                image[\"array\"]\n",
    "            )\n",
    "\n",
    "        raise ValueError(\n",
    "            \"Invalid image dictionary.\"\n",
    "        )\n",
    "\n",
    "    # Raw image bytes\n",
    "    if isinstance(image, (bytes, bytearray)):\n",
    "\n",
    "        return Image.open(\n",
    "            BytesIO(image)\n",
    "        ).convert(\"RGB\")\n",
    "\n",
    "    # List or tuple\n",
    "    if isinstance(image, (list, tuple)):\n",
    "\n",
    "        if len(image) == 0:\n",
    "            raise ValueError(\"Empty image list.\")\n",
    "\n",
    "        # Encoded image represented as byte values.\n",
    "        if all(\n",
    "            isinstance(x, (int, np.integer))\n",
    "            for x in image\n",
    "        ):\n",
    "\n",
    "            try:\n",
    "\n",
    "                return Image.open(\n",
    "                    BytesIO(bytes(image))\n",
    "                ).convert(\"RGB\")\n",
    "\n",
    "            except Exception:\n",
    "                pass\n",
    "\n",
    "        # Wrapped image\n",
    "        if len(image) == 1 and isinstance(\n",
    "            image[0],\n",
    "            (Image.Image, dict, bytes, bytearray, np.ndarray)\n",
    "        ):\n",
    "\n",
    "            return convert_to_pil(image[0])\n",
    "\n",
    "        # Pixel list\n",
    "        image = np.asarray(image)\n",
    "\n",
    "    # NumPy image\n",
    "    if isinstance(image, np.ndarray):\n",
    "\n",
    "        if image.size == 0:\n",
    "            raise ValueError(\"Empty image array.\")\n",
    "\n",
    "        # Grayscale H x W\n",
    "        if image.ndim == 2:\n",
    "            pass\n",
    "\n",
    "        # RGB image or channel-first image\n",
    "        elif image.ndim == 3:\n",
    "\n",
    "            if (\n",
    "                image.shape[0] in (1, 3, 4)\n",
    "                and image.shape[-1] not in (1, 3, 4)\n",
    "            ):\n",
    "\n",
    "                image = np.transpose(\n",
    "                    image, (1, 2, 0)\n",
    "                )\n",
    "\n",
    "            if image.shape[-1] == 1:\n",
    "\n",
    "                image = image.squeeze(-1)\n",
    "\n",
    "            elif image.shape[-1] == 4:\n",
    "\n",
    "                image = image[..., :3]\n",
    "\n",
    "            elif image.shape[-1] != 3:\n",
    "\n",
    "                raise ValueError(\n",
    "                    f\"Unsupported image shape: {image.shape}\"\n",
    "                )\n",
    "\n",
    "        else:\n",
    "\n",
    "            raise ValueError(\n",
    "                f\"Unsupported image dimensions: {image.shape}\"\n",
    "            )\n",
    "\n",
    "        # Convert to uint8\n",
    "        if image.dtype != np.uint8:\n",
    "\n",
    "            if not np.issubdtype(\n",
    "                image.dtype, np.number\n",
    "            ):\n",
    "\n",
    "                raise TypeError(\n",
    "                    \"Image must contain numeric pixels.\"\n",
    "                )\n",
    "\n",
    "            image = np.nan_to_num(image)\n",
    "\n",
    "            if image.min() >= 0 and image.max() <= 1:\n",
    "\n",
    "                image = image * 255\n",
    "\n",
    "            image = np.clip(\n",
    "                image, 0, 255\n",
    "            ).astype(np.uint8)\n",
    "\n",
    "        return Image.fromarray(image).convert(\"RGB\")\n",
    "\n",
    "    raise TypeError(\n",
    "        f\"Unsupported image type: {type(image)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. PYTORCH DATASET\n",
    "# ============================================================\n",
    "\n",
    "class MRIImageDataset(Dataset):\n",
    "\n",
    "    def __init__(self, hf_dataset, dataset_name):\n",
    "\n",
    "        self.dataset = hf_dataset\n",
    "\n",
    "        self.dataset_name = dataset_name\n",
    "\n",
    "        if IMAGE_COLUMN not in hf_dataset.column_names:\n",
    "            raise ValueError(\"Image column missing.\")\n",
    "\n",
    "        if LABEL_COLUMN not in hf_dataset.column_names:\n",
    "            raise ValueError(\"Label column missing.\")\n",
    "\n",
    "    def __len__(self):\n",
    "\n",
    "        return len(self.dataset)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "\n",
    "        sample = self.dataset[index]\n",
    "\n",
    "        try:\n",
    "\n",
    "            image = convert_to_pil(\n",
    "                sample[IMAGE_COLUMN]\n",
    "            )\n",
    "\n",
    "            image = DINO_TRANSFORM(image)\n",
    "\n",
    "            label = normalize_label(\n",
    "                sample[LABEL_COLUMN],\n",
    "                self.dataset_name\n",
    "            )\n",
    "\n",
    "            return image, label\n",
    "\n",
    "        except Exception as error:\n",
    "\n",
    "            raise RuntimeError(\n",
    "                f\"Image processing failed | \"\n",
    "                f\"Dataset: {self.dataset_name} | \"\n",
    "                f\"Index: {index} | \"\n",
    "                f\"Error: {error}\"\n",
    "            ) from error\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. DATASET VALIDATION\n",
    "# ============================================================\n",
    "\n",
    "def validate_split(dataset_name, split_name):\n",
    "\n",
    "    print(\n",
    "        f\"\\nLoading {dataset_name.upper()} \"\n",
    "        f\"{split_name.upper()}\"\n",
    "    )\n",
    "\n",
    "    hf_dataset = load_dataset(\n",
    "        DATASETS[dataset_name],\n",
    "        split=split_name\n",
    "    )\n",
    "\n",
    "    if len(hf_dataset) == 0:\n",
    "\n",
    "        raise ValueError(\n",
    "            \"Dataset split is empty.\"\n",
    "        )\n",
    "\n",
    "    encoded_labels = [\n",
    "\n",
    "        normalize_label(label, dataset_name)\n",
    "\n",
    "        for label in hf_dataset[LABEL_COLUMN]\n",
    "\n",
    "    ]\n",
    "\n",
    "    unique, counts = np.unique(\n",
    "        encoded_labels,\n",
    "        return_counts=True\n",
    "    )\n",
    "\n",
    "    print(\"Total samples:\", len(hf_dataset))\n",
    "\n",
    "    print(\"Class distribution:\")\n",
    "\n",
    "    for class_id, count in zip(unique, counts):\n",
    "\n",
    "        print(\n",
    "            f\"{ID_TO_CLASS[class_id]}: {count}\"\n",
    "        )\n",
    "\n",
    "    return hf_dataset, encoded_labels\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. CACHE MANAGEMENT\n",
    "# ============================================================\n",
    "\n",
    "def get_cache_paths(dataset_name, split_name):\n",
    "\n",
    "    filename = f\"{dataset_name}_{split_name}\"\n",
    "\n",
    "    feature_path = os.path.join(\n",
    "        FEATURE_DIR,\n",
    "        filename + \".pt\"\n",
    "    )\n",
    "\n",
    "    metadata_path = os.path.join(\n",
    "        FEATURE_DIR,\n",
    "        filename + \"_metadata.json\"\n",
    "    )\n",
    "\n",
    "    return feature_path, metadata_path\n",
    "\n",
    "\n",
    "def load_cached_tensor(path):\n",
    "\n",
    "    try:\n",
    "\n",
    "        return torch.load(\n",
    "            path,\n",
    "            map_location=\"cpu\",\n",
    "            weights_only=True\n",
    "        )\n",
    "\n",
    "    except TypeError:\n",
    "\n",
    "        return torch.load(\n",
    "            path,\n",
    "            map_location=\"cpu\"\n",
    "        )\n",
    "\n",
    "\n",
    "def cache_is_valid(\n",
    "    dataset_name,\n",
    "    split_name,\n",
    "    sample_count,\n",
    "    fingerprint\n",
    "):\n",
    "\n",
    "    feature_path, metadata_path = get_cache_paths(\n",
    "        dataset_name, split_name\n",
    "    )\n",
    "\n",
    "    if not os.path.exists(feature_path):\n",
    "        return False\n",
    "\n",
    "    if not os.path.exists(metadata_path):\n",
    "        return False\n",
    "\n",
    "    try:\n",
    "\n",
    "        with open(metadata_path, \"r\") as f:\n",
    "\n",
    "            metadata = json.load(f)\n",
    "\n",
    "        expected = {\n",
    "\n",
    "            \"cache_version\": CACHE_VERSION,\n",
    "\n",
    "            \"dataset\": dataset_name,\n",
    "\n",
    "            \"split\": split_name,\n",
    "\n",
    "            \"sample_count\": sample_count,\n",
    "\n",
    "            \"fingerprint\": fingerprint,\n",
    "\n",
    "            \"model\": \"dinov2_vitb14\",\n",
    "\n",
    "            \"image_size\": IMAGE_SIZE,\n",
    "\n",
    "            \"class_mapping\": CLASS_TO_ID\n",
    "\n",
    "        }\n",
    "\n",
    "        for key, value in expected.items():\n",
    "\n",
    "            if metadata.get(key) != value:\n",
    "\n",
    "                return False\n",
    "\n",
    "        cached = load_cached_tensor(feature_path)\n",
    "\n",
    "        features = cached[\"features\"]\n",
    "\n",
    "        labels = cached[\"labels\"]\n",
    "\n",
    "        return (\n",
    "\n",
    "            features.shape == (\n",
    "                sample_count,\n",
    "                FEATURE_DIM\n",
    "            )\n",
    "\n",
    "            and labels.shape == (sample_count,)\n",
    "\n",
    "            and torch.isfinite(features).all().item()\n",
    "\n",
    "            and labels.min().item() >= 0\n",
    "\n",
    "            and labels.max().item() <= 3\n",
    "\n",
    "        )\n",
    "\n",
    "    except Exception as error:\n",
    "\n",
    "        print(\"Cache validation failed:\", error)\n",
    "\n",
    "        return False\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. DINOV2 CLS TOKEN FEATURE EXTRACTION\n",
    "# ============================================================\n",
    "\n",
    "def extract_and_cache_features(\n",
    "    dataset_name,\n",
    "    split_name\n",
    "):\n",
    "\n",
    "    hf_dataset, encoded_labels = validate_split(\n",
    "        dataset_name,\n",
    "        split_name\n",
    "    )\n",
    "\n",
    "    sample_count = len(hf_dataset)\n",
    "\n",
    "    fingerprint = getattr(\n",
    "        hf_dataset,\n",
    "        \"_fingerprint\",\n",
    "        \"unknown\"\n",
    "    )\n",
    "\n",
    "    feature_path, metadata_path = get_cache_paths(\n",
    "        dataset_name,\n",
    "        split_name\n",
    "    )\n",
    "\n",
    "    # Check existing cache.\n",
    "    if cache_is_valid(\n",
    "        dataset_name,\n",
    "        split_name,\n",
    "        sample_count,\n",
    "        fingerprint\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            \"\\nValid feature cache found.\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"Skipping extraction:\",\n",
    "            feature_path\n",
    "        )\n",
    "\n",
    "        del hf_dataset\n",
    "\n",
    "        gc.collect()\n",
    "\n",
    "        return\n",
    "\n",
    "    print(\n",
    "        f\"\\nExtracting features for \"\n",
    "        f\"{dataset_name.upper()} / {split_name.upper()}\"\n",
    "    )\n",
    "\n",
    "    # Remove incompatible cache.\n",
    "    for path in [feature_path, metadata_path]:\n",
    "\n",
    "        if os.path.exists(path):\n",
    "\n",
    "            os.remove(path)\n",
    "\n",
    "    torch_dataset = MRIImageDataset(\n",
    "        hf_dataset,\n",
    "        dataset_name\n",
    "    )\n",
    "\n",
    "    loader = DataLoader(\n",
    "\n",
    "        torch_dataset,\n",
    "\n",
    "        batch_size=BATCH_SIZE,\n",
    "\n",
    "        shuffle=False,\n",
    "\n",
    "        num_workers=NUM_WORKERS,\n",
    "\n",
    "        pin_memory=(DEVICE.type == \"cuda\"),\n",
    "\n",
    "        drop_last=False\n",
    "\n",
    "    )\n",
    "\n",
    "    all_features = []\n",
    "\n",
    "    all_labels = []\n",
    "\n",
    "    # Feature extraction.\n",
    "    with torch.inference_mode():\n",
    "\n",
    "        for images, labels in tqdm(\n",
    "            loader,\n",
    "            desc=f\"{dataset_name}/{split_name}\"\n",
    "        ):\n",
    "\n",
    "            images = images.to(\n",
    "                DEVICE,\n",
    "                non_blocking=True\n",
    "            )\n",
    "\n",
    "            # IMPORTANT:\n",
    "            # Use forward_features(), not the default forward().\n",
    "            # It returns a dictionary containing normalized CLS tokens.\n",
    "\n",
    "            output = dino_model.forward_features(images)\n",
    "\n",
    "            if not isinstance(output, dict):\n",
    "\n",
    "                raise TypeError(\n",
    "                    \"Unexpected DINOv2 output type: \"\n",
    "                    f\"{type(output)}\"\n",
    "                )\n",
    "\n",
    "            if \"x_norm_clstoken\" not in output:\n",
    "\n",
    "                raise KeyError(\n",
    "                    \"DINOv2 output does not contain \"\n",
    "                    \"'x_norm_clstoken'.\"\n",
    "                )\n",
    "\n",
    "            # Extract normalized CLS token.\n",
    "            features = output[\"x_norm_clstoken\"]\n",
    "\n",
    "            # Expected shape: [batch_size, 768]\n",
    "            if features.ndim != 2:\n",
    "\n",
    "                raise ValueError(\n",
    "                    f\"Expected 2D CLS features, \"\n",
    "                    f\"received {features.shape}\"\n",
    "                )\n",
    "\n",
    "            if features.shape[1] != FEATURE_DIM:\n",
    "\n",
    "                raise ValueError(\n",
    "                    f\"Expected {FEATURE_DIM} features, \"\n",
    "                    f\"received {features.shape}\"\n",
    "                )\n",
    "\n",
    "            # Move to CPU.\n",
    "            features = features.float().cpu()\n",
    "\n",
    "            # Validate features.\n",
    "            if not torch.isfinite(features).all():\n",
    "\n",
    "                raise ValueError(\n",
    "                    \"Non-finite feature values detected.\"\n",
    "                )\n",
    "\n",
    "            # Save batch.\n",
    "            all_features.append(features)\n",
    "\n",
    "            all_labels.append(\n",
    "                labels.long().cpu()\n",
    "            )\n",
    "\n",
    "            # Display first batch shape.\n",
    "            if len(all_features) == 1:\n",
    "\n",
    "                print(\n",
    "                    \"\\nFirst batch feature shape:\",\n",
    "                    tuple(features.shape)\n",
    "                )\n",
    "\n",
    "            del images, output, features\n",
    "\n",
    "    # Check extraction.\n",
    "    if len(all_features) == 0:\n",
    "\n",
    "        raise ValueError(\n",
    "            \"No features were extracted.\"\n",
    "        )\n",
    "\n",
    "    # Combine batches.\n",
    "    features = torch.cat(\n",
    "        all_features,\n",
    "        dim=0\n",
    "    )\n",
    "\n",
    "    labels = torch.cat(\n",
    "        all_labels,\n",
    "        dim=0\n",
    "    )\n",
    "\n",
    "    # Final shape validation.\n",
    "    expected_shape = (\n",
    "        sample_count,\n",
    "        FEATURE_DIM\n",
    "    )\n",
    "\n",
    "    if tuple(features.shape) != expected_shape:\n",
    "\n",
    "        raise ValueError(\n",
    "            f\"Unexpected feature shape: {features.shape}. \"\n",
    "            f\"Expected: {expected_shape}\"\n",
    "        )\n",
    "\n",
    "    if labels.shape != (sample_count,):\n",
    "\n",
    "        raise ValueError(\n",
    "            f\"Unexpected label shape: {labels.shape}\"\n",
    "        )\n",
    "\n",
    "    # Verify labels.\n",
    "    expected_labels = torch.tensor(\n",
    "        encoded_labels,\n",
    "        dtype=torch.long\n",
    "    )\n",
    "\n",
    "    if not torch.equal(labels, expected_labels):\n",
    "\n",
    "        raise ValueError(\n",
    "            \"Extracted labels do not match dataset labels.\"\n",
    "        )\n",
    "\n",
    "    # ========================================================\n",
    "    # SAVE FEATURE CACHE\n",
    "    # ========================================================\n",
    "\n",
    "    temporary_path = feature_path + \".tmp\"\n",
    "\n",
    "    torch.save(\n",
    "        {\n",
    "            \"features\": features,\n",
    "            \"labels\": labels\n",
    "        },\n",
    "        temporary_path\n",
    "    )\n",
    "\n",
    "    os.replace(\n",
    "        temporary_path,\n",
    "        feature_path\n",
    "    )\n",
    "\n",
    "    # ========================================================\n",
    "    # SAVE METADATA\n",
    "    # ========================================================\n",
    "\n",
    "    metadata = {\n",
    "\n",
    "        \"cache_version\": CACHE_VERSION,\n",
    "\n",
    "        \"dataset\": dataset_name,\n",
    "\n",
    "        \"split\": split_name,\n",
    "\n",
    "        \"sample_count\": sample_count,\n",
    "\n",
    "        \"fingerprint\": fingerprint,\n",
    "\n",
    "        \"model\": \"dinov2_vitb14\",\n",
    "\n",
    "        \"feature_dimension\": FEATURE_DIM,\n",
    "\n",
    "        \"feature_type\": \"normalized_cls_token\",\n",
    "\n",
    "        \"image_size\": IMAGE_SIZE,\n",
    "\n",
    "        \"class_mapping\": CLASS_TO_ID,\n",
    "\n",
    "        \"sartaj_mapping\": SARTAJ_ID_TO_CLASS\n",
    "\n",
    "    }\n",
    "\n",
    "    temporary_metadata = metadata_path + \".tmp\"\n",
    "\n",
    "    with open(temporary_metadata, \"w\") as f:\n",
    "\n",
    "        json.dump(\n",
    "            metadata,\n",
    "            f,\n",
    "            indent=4\n",
    "        )\n",
    "\n",
    "    os.replace(\n",
    "        temporary_metadata,\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "    # ========================================================\n",
    "    # REPORT RESULTS\n",
    "    # ========================================================\n",
    "\n",
    "    print(\"\\nExtraction completed successfully.\")\n",
    "\n",
    "    print(\"Dataset:\", dataset_name.upper())\n",
    "\n",
    "    print(\"Split:\", split_name.upper())\n",
    "\n",
    "    print(\"Feature shape:\", tuple(features.shape))\n",
    "\n",
    "    print(\"Label shape:\", tuple(labels.shape))\n",
    "\n",
    "    print(\"Feature dimension:\", features.shape[1])\n",
    "\n",
    "    print(\"Saved:\", feature_path)\n",
    "\n",
    "    unique, counts = torch.unique(\n",
    "        labels,\n",
    "        return_counts=True\n",
    "    )\n",
    "\n",
    "    print(\"\\nExtracted class distribution:\")\n",
    "\n",
