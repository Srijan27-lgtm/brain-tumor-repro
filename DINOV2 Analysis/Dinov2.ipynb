    "\n",
    "if filters is not None:\n",
    "    k_size = filters.shape[2]\n",
    "    grid_img = np.zeros((3*(k_size+1), 3*(k_size+1)))\n",
    "    for i in range(3):\n",
    "        for j in range(3):\n",
    "            f = filters[i*3+j, 0, :, :].cpu().numpy()\n",
